<Window x:Class="NA_0lab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NA_0lab"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Canvas x:Name="Scene" 
                HorizontalAlignment="Left" 
                Height="400" 
                Margin="15,0,0,0" 
                VerticalAlignment="Center" 
                Width="680" 
                Background="White"/>

        <Button x:Name="DrawTriangleButton" 
        Content="Нарисовать треугольник" 
        Width="150" 
        Height="30" 
        Margin="15,10,0,0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top" 
        Background="#B3E5FC"
        Click="DrawTriangleButton_Click"/>

        <Button x:Name="DrawRectangleButton" 
        Content="Нарисовать прямоугольник" 
        Width="180" 
        Height="30" 
        Margin="350,10,0,0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top" 
        Background="#B3E5FC"
        Click="DrawRectangleButton_Click"/>

    </Grid>


</Window>
